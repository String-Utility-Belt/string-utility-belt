{
    "name": "string-utility-belt",
    "version": "1.12.3",
    "description": "Chain string transformations into visual pipelines with live previews — web app, CLI, HTTP API, MCP server and editor/browser extensions.",
    "license": "MIT",
    "homepage": "https://stringutilitybelt.com",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/String-Utility-Belt/string-utility-belt.git"
    },
    "bugs": {
        "url": "https://github.com/String-Utility-Belt/string-utility-belt/issues"
    },
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "gen": "vite-node scripts/gen.ts",
        "predev": "npm run gen",
        "dev": "vite",
        "prebuild": "npm run gen",
        "build": "vite build",
        "postbuild": "vite-node scripts/build-seo.ts -- --og-if-workers-ci",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "preview": "npm run build && vite preview",
        "deploy": "npm run build:site && wrangler deploy",
        "cf-typegen": "wrangler types",
        "test": "vitest run",
        "build:core": "vite build --config packages/core/vite.config.ts",
        "build:cli": "vite build --config packages/cli/vite.config.ts",
        "build:mcp": "vite build --config packages/mcp/vite.config.ts",
        "build:extension": "vite build --config packages/extension/vite.config.ts",
        "build:vscode": "vite build --config packages/vscode/vite.config.ts",
        "build:tools": "npm run build:core && npm run build:cli && npm run build:mcp && npm run build:extension && npm run build:vscode",
        "build:seo": "vite-node scripts/build-seo.ts",
        "check:bundle": "vite-node scripts/check-bundle.ts",
        "bench": "vitest bench --run",
        "test:e2e": "playwright test",
        "build:seo:fast": "vite-node scripts/build-seo.ts -- --no-og",
        "check:guides": "vite-node scripts/check-guides.ts",
        "check:presets": "vite-node scripts/check-presets.ts",
        "build:site": "npm run build && npm run build:seo",
        "events": "vite-node scripts/events.ts",
        "readme:demo": "vite-node scripts/readme-demo.ts",
        "release": "vite-node scripts/release.ts"
    },
    "dependencies": {
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-xml": "^6.1.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.13",
        "@modelcontextprotocol/sdk": "^1.32.0",
        "@uiw/react-codemirror": "^4.25.12",
        "brotli": "^1.3.3",
        "cronstrue": "^3.27.0",
        "diff": "^9.0.0",
        "fflate": "^0.8.3",
        "framer-motion": "^11.0.0",
        "franc-min": "^6.2.0",
        "hash-wasm": "^4.12.0",
        "lucide-react": "^1.52.0",
        "lz-string": "^1.5.0",
        "marked": "^18.0.14",
        "pluralize": "^8.0.0",
        "qrcode-generator": "^2.0.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "smol-toml": "^1.9.0",
        "sql-formatter": "^15.9.0",
        "turndown": "^7.2.4",
        "ua-parser-js": "^2.0.10",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.62.5",
        "@eslint/js": "^9.39.5",
        "@fontsource/instrument-sans": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@playwright/test": "^1.63.0",
        "@resvg/resvg-wasm": "^2.6.2",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "^6.4.8",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/chrome": "^0.3.4",
        "@types/node": "^24.6.2",
        "@types/pluralize": "^0.0.33",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@types/turndown": "^5.0.6",
        "@types/vscode": "^1.140.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^9.36.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "fast-check": "^4.10.2",
        "globals": "^17.13.0",
        "jsdom": "^27.0.0",
        "postcss": "^8.5.29",
        "satori": "^0.35.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vite-node": "^6.0.0",
        "vitest": "^5.0.3",
        "wrangler": "^4.147.0"
    },
    "bin": {
        "subelt": "packages/cli/dist/subelt.mjs"
    }
}
